{% extends 'base.html.twig' %}

{% block body %}
    <h1>Lista de Contactos</h1>
    
    <ul>
    {% for contacto in contactos %}
        <li>
            <a href="{{ path('contacto', {'codigo': contacto.id}) }}">{{ contacto.nombre }}</a>
            - <a href="{{ path('editar', {'codigo': contacto.id}) }}">Editar / Modificar</a>
        </li>
    {% else %}
        <li>No hay contactos.</li>
    {% endfor %}
    </ul>

    <a href="{{ path('nuevo') }}">Nuevo Contacto</a>
{% endblock %}
